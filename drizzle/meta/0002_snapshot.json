          "name": "published_has_location",
          "value": "\"postcards\".\"status\" = 'draft' OR (\"postcards\".\"lat\" IS NOT NULL AND \"postcards\".\"lng\" IS NOT NULL AND \"postcards\".\"published_at\" IS NOT NULL)"
