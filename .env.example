# Neon Postgres connection string (use a dev branch locally)
DATABASE_URL=postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=postcards

# Auth: generate with `npm run hash-password -- 'your password'` (scrypt, salt:hash hex)
APP_PASSWORD_HASH=
# Any long random string, e.g. `openssl rand -base64 32`
SESSION_SECRET=
