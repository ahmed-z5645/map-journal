# Neon Postgres *pooled* connection string (host contains "-pooler"); use a dev branch locally
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Or a local Postgres for offline dev, e.g. postgres://postgres:postgres@localhost:5432/postcards

# Cloudflare R2 (private bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=postcards
# Optional: S3-compatible endpoint for local dev (e.g. MinIO at http://localhost:9000)
# R2_ENDPOINT=

# Auth: generate with `npm run hash-password -- 'your password'` (scrypt, salt:hash hex)
APP_PASSWORD_HASH=
# Any long random string, e.g. `openssl rand -base64 32`
SESSION_SECRET=
